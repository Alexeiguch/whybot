# Copy to .env (or .env.local) and fill in. Never commit the filled-in file.

# --- NVIDIA build (OpenAI-compatible) : Nemotron models
NVIDIA_API_KEY=nvapi-your-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
PLANNER_MODEL=nvidia/nemotron-3-ultra-550b-a55b
CRITIC_MODEL=nvidia/nemotron-3-ultra-550b-a55b
SQL_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
WRITER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Comma list of roles that run with reasoning on (planner,critic). Off by default: slower but more careful.
LLM_THINKING_ROLES=

# --- Zetaris Lightning (JDBC)
ZETARIS_JDBC_URL=jdbc:zetaris:lightning@localhost:10000
ZETARIS_JDBC_JAR=/path/to/ndp-jdbc-driver-x.y.z-driver.jar
ZETARIS_JDBC_CLASS=com.zetaris.lightning.jdbc.LightningDriver
ZETARIS_USERNAME=your-username
ZETARIS_PASSWORD=your-password
ZETARIS_DATABASES=NY_TAXI,NOAA_GHCN_S3,HOLIDAYS
# Optional allowlist of DATABASE.table names exposed to the agents
ZETARIS_TABLES=

# --- Runtime
# zetaris | replay | dev   (dev = DEV-ONLY DuckDB sample, never for the demo)
DATA_SOURCE=zetaris
# SAMPLE_MODE=true replays RECORDED real Zetaris results from fixtures/recorded (no Zetaris needed)
SAMPLE_MODE=false
RECORD_FIXTURES=false
MAX_ITERATIONS=3
LLM_TIMEOUT_S=90
SQL_TIMEOUT_S=60
RUN_TIMEOUT_S=600
HMEM_THRESHOLD=0.15
METERLESS_ENABLED=true
PORT=8000
