{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, y.trips, MAX(CASE WHEN h.is_national = TRUE THEN h.holiday_name END) AS holiday_name FROM whybot.yellow_daily y LEFT JOIN whybot.us_holidays h ON h.holiday_date = y.trip_date JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE d.d_dow = 5 AND y.trip_date BETWEEN DATE '2024-04-01' AND DATE '2025-02-28' GROUP BY y.trip_date, y.trips ORDER BY y.trip_date LIMIT 500",
