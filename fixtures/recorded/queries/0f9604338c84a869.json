{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN y.avg_total_amount END) AS target_avg_total_amount, AVG(CASE WHEN y.trip_date <> DATE '2024-11-28' AND d.d_dow = 4 THEN y.avg_total_amount END) AS baseline_avg_total_amount, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN y.avg_trip_distance END) AS target_avg_trip_distance, AVG(CASE WHEN y.trip_date <> DATE '2024-11-28' AND d.d_dow = 4 THEN y.avg_trip_distance END) AS baseline_avg_trip_distance FROM whybot.yellow_daily y JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2024-11-01' AND DATE '2024-11-30' GROUP BY y.trip_date ORDER BY y.trip_date LIMIT 500",
