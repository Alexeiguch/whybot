{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, MAX(CASE WHEN d.d_dow = 6 AND d.d_date = DATE '2024-12-21' THEN y.avg_trip_distance END) AS target_avg_trip_distance, AVG(CASE WHEN d.d_dow = 6 AND d.d_date <> DATE '2024-12-21' THEN y.avg_trip_distance END) AS baseline_avg_trip_distance, MAX(CASE WHEN d.d_dow = 6 AND d.d_date = DATE '2024-12-21' THEN y.avg_total_amount END) AS target_avg_total_amount, AVG(CASE WHEN d.d_dow = 6 AND d.d_date <> DATE '2024-12-21' THEN y.avg_total_amount END) AS baseline_avg_total_amount FROM whybot.yellow_daily y JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2024-12-01' AND DATE '2024-12-31' GROUP BY y.trip_date ORDER BY y.trip_date LIMIT 500",
