 "source": "zetaris",
 "sql": "SELECT y.trip_date, y.trips AS trip_count, y.avg_total_amount AS avg_fare, CASE WHEN dayofweek(y.trip_date) = 2 THEN 'Monday' ELSE NULL END AS weekday_flag, MAX(CASE WHEN dayofweek(y.trip_date) = 2 AND y.trip_date < DATE '2025-01-20' THEN y.avg_total_amount END) AS prev_monday_avg, MAX(CASE WHEN dayofweek(y.trip_date) = 2 AND y.trip_date > DATE '2025-01-20' THEN y.avg_total_amount END) AS next_monday_avg FROM whybot.yellow_daily y WHERE y.trip_date BETWEEN DATE '2025-01-01' AND DATE '2025-01-31' GROUP BY y.trip_date, y.trips, y.avg_total_amount ORDER BY y.trip_date LIMIT 500",
