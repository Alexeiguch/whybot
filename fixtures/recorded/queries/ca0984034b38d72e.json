 "source": "zetaris",
 "sql": "SELECT y.trip_date, w.prcp_mm, w.snow_mm, w.tmax_c, w.tmin_c, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN y.trips END) AS target_trips, AVG(CASE WHEN y.trip_date <> DATE '2024-11-28' AND d.d_dow = 1 THEN y.trips END) AS baseline_avg_trips FROM whybot.yellow_daily y JOIN whybot.nyc_weather_daily w ON w.obs_date = y.trip_date JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2024-11-01' AND DATE '2024-11-30' GROUP BY y.trip_date, w.prcp_mm, w.snow_mm, w.tmax_c, w.tmin_c ORDER BY y.trip_date LIMIT 500",
