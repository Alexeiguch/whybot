 "sql": "SELECT y.trip_date, y.trips AS trips, w.snow_mm AS snow_mm, h.holiday_name AS holiday_name, d.d_day_name AS day_name FROM whybot.yellow_daily y JOIN whybot.nyc_weather_daily w ON w.obs_date = y.trip_date LEFT JOIN whybot.us_holidays h ON h.holiday_date = y.trip_date JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE d.d_dow IN (1,6,0,5) AND y.trip_date BETWEEN DATE '2024-12-01' AND DATE '2024-12-31' ORDER BY y.trip_date LIMIT 500",
