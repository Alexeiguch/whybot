{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, MAX(CASE WHEN y.trip_date = DATE '2025-01-20' THEN y.avg_total_amount END) AS target_avg_total_amount, AVG(CASE WHEN y.trip_date <> DATE '2025-01-20' AND d.d_moy = 1 AND d.d_dow = 1 THEN y.avg_total_amount END) AS baseline_avg_total_amount FROM whybot.yellow_daily y JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2025-01-01' AND DATE '2025-01-31' GROUP BY y.trip_date ORDER BY y.trip_date LIMIT 31",
