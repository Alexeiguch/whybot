 "source": "zetaris",
 "sql": "SELECT y.trip_date, y.avg_total_amount, y.avg_trip_distance, CASE WHEN dayofweek(y.trip_date) = 2 THEN 'Monday' ELSE NULL END AS day_type, MAX(CASE WHEN dayofweek(y.trip_date) = 2 AND y.trip_date < DATE '2025-01-20' THEN y.avg_total_amount END) AS baseline_avg_amount, MAX(CASE WHEN dayofweek(y.trip_date) = 2 AND y.trip_date < DATE '2025-01-20' THEN y.avg_trip_distance END) AS baseline_avg_distance FROM whybot.yellow_daily y WHERE y.trip_date BETWEEN DATE '2025-01-01' AND DATE '2025-01-31' GROUP BY y.trip_date, y.avg_total_amount, y.avg_trip_distance ORDER BY y.trip_date LIMIT 500",
