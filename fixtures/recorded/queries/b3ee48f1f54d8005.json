{
 "source": "zetaris",
 "sql": "SELECT w.obs_date, MAX(CASE WHEN d.d_dow = 6 THEN w.snow_mm ELSE NULL END) AS target_snow_mm, MAX(CASE WHEN d.d_dow = 6 THEN w.prcp_mm ELSE NULL END) AS target_prcp_mm, MAX(CASE WHEN d.d_dow = 6 THEN w.tmax_c ELSE NULL END) AS target_tmax_c, MAX(CASE WHEN d.d_dow = 6 THEN w.tmin_c ELSE NULL END) AS target_tmin_c, MAX(CASE WHEN d.d_dow <> 6 THEN w.snow_mm ELSE NULL END) AS baseline_snow_mm, MAX(CASE WHEN d.d_dow <> 6 THEN w.prcp_mm ELSE NULL END) AS baseline_prcp_mm, MAX(CASE WHEN d.d_dow <> 6 THEN w.tmax_c ELSE NULL END) AS baseline_tmax_c, MAX(CASE WHEN d.d_dow <> 6 THEN w.tmin_c ELSE NULL END) AS baseline_tmin_c FROM whybot.yellow_daily y JOIN whybot.nyc_weather_daily w ON w.obs_date = y.trip_date JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2024-11-01' AND DATE '2024-12-31' GROUP BY w.obs_date ORDER BY w.obs_date LIMIT 500",
