{
 "source": "zetaris",
 "sql": "SELECT tz.zone, tz.LocationID, CASE WHEN tz.zone LIKE '%JFK%' THEN 'JFK' WHEN tz.zone LIKE '%LGA%' THEN 'LGA' WHEN tz.zone LIKE '%Newark%' THEN 'Newark' WHEN tz.borough = 'Manhattan' THEN 'Manhattan' ELSE 'Other' END AS zone_category FROM NY_TAXI.taxi_zones tz WHERE tz.LocationID IS NOT NULL ORDER BY zone_category, tz.zone LIMIT 500",
 "sql_hash": "sha256:dbb3c6c781b026c6",
 "recorded_at": "2026-10-22T14:24:58+00:00",
