{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, MAX(CASE WHEN d.d_day_name = 'Monday' AND y.trip_date = DATE '2025-01-20' THEN y.avg_total_amount END) AS target_amount, AVG(CASE WHEN d.d_day_name = 'Monday' AND y.trip_date <> DATE '2025-01-20' THEN y.avg_total_amount END) AS baseline_avg_amount, MAX(CASE WHEN d.d_day_name = 'Monday' AND y.trip_date = DATE '2025-01-20' THEN h.holiday_name END) AS holiday_name, COUNT(CASE WHEN d.d_day_name = 'Monday' AND y.trip_date = DATE '2025-01-20' THEN 1 END) AS is_mlk_day FROM whybot.yellow_daily y JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date LEFT JOIN whybot.us_holidays h ON h.holiday_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2025-01-01' AND DATE '2025-01-31' GROUP BY y.trip_date ORDER BY y.trip_date LIMIT 500",
