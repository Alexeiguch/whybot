 "sql": "SELECT y.trip_date, d.d_dow, d.d_day_name, d.d_weekend, CASE WHEN d.d_dow IN (5,6) THEN 'Y' ELSE 'N' END AS is_weekend, w.snow_mm, y.trips FROM whybot.yellow_daily y JOIN whybot.nyc_weather_daily w ON w.obs_date = y.trip_date JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2024-11-01' AND DATE '2024-12-31' AND d.d_dow IN (5,6) ORDER BY y.trip_date LIMIT 500",
