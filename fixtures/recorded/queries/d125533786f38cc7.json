{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, MAX(CASE WHEN y.trip_date = DATE '2025-01-20' THEN y.trips END) AS target_trips, AVG(CASE WHEN y.trip_date <> DATE '2025-01-20' AND dayofweek(y.trip_date) = 1 THEN y.trips END) AS baseline_avg_trips FROM whybot.yellow_daily y WHERE y.trip_date BETWEEN DATE '2025-01-01' AND DATE '2025-01-31' GROUP BY y.trip_date ORDER BY y.trip_date LIMIT 500",
