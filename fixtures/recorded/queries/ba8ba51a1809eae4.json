{
 "source": "zetaris",
 "sql": "SELECT trip_date, MAX(CASE WHEN trip_date = DATE '2025-01-20' THEN trips END) AS target_trips, AVG(CASE WHEN trip_date <> DATE '2025-01-20' AND dayofweek(trip_date) = 2 THEN trips END) AS baseline_avg_trips, MAX(CASE WHEN trip_date = DATE '2025-01-20' THEN avg_trip_distance END) AS target_avg_distance, AVG(CASE WHEN trip_date <> DATE '2025-01-20' AND dayofweek(trip_date) = 2 THEN avg_trip_distance END) AS baseline_avg_distance, MAX(CASE WHEN trip_date = DATE '2025-01-20' THEN avg_total_amount END) AS target_avg_amount, AVG(CASE WHEN trip_date <> DATE '2025-01-20' AND dayofweek(trip_date) = 2 THEN avg_total_amount END) AS baseline_avg_amount FROM whybot.yellow_daily WHERE trip_date BETWEEN DATE '2025-01-01' AND DATE '2025-01-31' GROUP BY trip_date ORDER BY trip_date LIMIT 500",
