 "sql": "SELECT y.trip_date, y.trips, w.prcp_mm, w.snow_mm, h.holiday_name, d.d_day_name FROM whybot.yellow_daily y LEFT JOIN whybot.nyc_weather_daily w ON w.obs_date = y.trip_date LEFT JOIN whybot.us_holidays h ON h.holiday_date = y.trip_date JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2024-11-01' AND DATE '2024-11-30' ORDER BY y.trip_date LIMIT 500",
