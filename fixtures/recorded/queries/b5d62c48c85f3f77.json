{
 "source": "zetaris",
 "sql": "SELECT trip_date, to_date(trip_date) AS trip_date_obj, CASE WHEN dayofweek(trip_date) = 5 THEN 'Thursday' ELSE NULL END AS weekday_label, MAX(CASE WHEN trip_date = DATE '2024-11-28' THEN avg_total_amount END) AS target_avg_total_amount, MAX(CASE WHEN trip_date = DATE '2024-11-28' THEN avg_trip_distance END) AS target_avg_trip_distance, AVG(CASE WHEN trip_date <> DATE '2024-11-28' AND dayofweek(trip_date) = 5 THEN avg_total_amount END) AS baseline_avg_total_amount, AVG(CASE WHEN trip_date <> DATE '2024-11-28' AND dayofweek(trip_date) = 5 THEN avg_trip_distance END) AS baseline_avg_trip_distance FROM whybot.yellow_daily WHERE trip_date BETWEEN DATE '2024-11-01' AND DATE '2024-12-31' GROUP BY trip_date ORDER BY trip_date LIMIT 100",
