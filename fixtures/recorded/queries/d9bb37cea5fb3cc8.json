{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN y.trips END) AS target_trips, AVG(CASE WHEN d.d_dow = 5 AND y.trip_date <> DATE '2024-11-28' THEN y.trips END) AS baseline_avg_trips, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN w.prcp_mm END) AS target_prcp_mm, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN w.snow_mm END) AS target_snow_mm, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN w.tmax_c END) AS target_tmax_c, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN w.tmin_c END) AS target_tmin_c FROM whybot.yellow_daily y JOIN whybot.nyc_weather_daily w ON w.obs_date = y.trip_date JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2024-11-01' AND DATE '2024-12-31' GROUP BY y.trip_date ORDER BY y.trip_date LIMIT 500",
