{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN y.trips END) AS target_trips, AVG(CASE WHEN y.trip_date <> DATE '2024-11-28' THEN y.trips END) AS baseline_avg_trips, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN h.holiday_name END) AS holiday_name FROM whybot.yellow_daily y LEFT JOIN whybot.us_holidays h ON h.holiday_date = y.trip_date JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2024-11-01' AND DATE '2024-12-31' GROUP BY y.trip_date ORDER BY y.trip_date LIMIT 500",
