{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, MAX(CASE WHEN trip_date = DATE '2025-01-20' THEN y.avg_trip_distance END) AS target_distance, AVG(CASE WHEN trip_date <> DATE '2025-01-20' AND dayofweek(trip_date) = 2 THEN y.avg_trip_distance END) AS baseline_avg_distance FROM whybot.yellow_daily y WHERE y.trip_date BETWEEN DATE '2025-01-01' AND DATE '2025-01-31' GROUP BY y.trip_date ORDER BY y.trip_date LIMIT 500",
