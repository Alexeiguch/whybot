{
 "source": "zetaris",
 "sql": "SELECT y.trip_date, MAX(CASE WHEN y.trip_date = DATE '2024-11-28' THEN y.trips END) AS target_trips, AVG(CASE WHEN d.d_dow = 4 AND y.trip_date IN (DATE '2024-11-07', DATE '2024-11-14', DATE '2024-11-21', DATE '2024-12-05', DATE '2024-12-12', DATE '2024-12-19', DATE '2024-12-26') THEN y.trips END) AS baseline_avg_trips FROM whybot.yellow_daily y JOIN TPCDS_DB.date_dim d ON d.d_date = y.trip_date WHERE y.trip_date BETWEEN DATE '2024-11-01' AND DATE '2024-12-31' GROUP BY y.trip_date ORDER BY y.trip_date LIMIT 500",
