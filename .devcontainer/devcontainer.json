{
  "name": "WhyBot Playground",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/java:1": { "version": "17", "installMaven": "false", "installGradle": "false" }
  },
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "containerEnv": {
    "SAMPLE_MODE": "true",
    "GRADIO_ANALYTICS_ENABLED": "False",
    "GRADIO_SERVER_NAME": "0.0.0.0",
    "GRADIO_SERVER_PORT": "7860",
    "WHYBOT_API_HOST": "0.0.0.0",
    "WHYBOT_API_PORT": "8000"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": { "playground": "bash playground/run.sh" },
  "forwardPorts": [7860, 8000],
  "portsAttributes": {
    "7860": { "label": "WhyBot Playground", "onAutoForward": "openBrowser" },
    "8000": { "label": "WhyBot API + built-in UI", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["PLAYGROUND.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
